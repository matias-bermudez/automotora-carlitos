{
  "name": "automotora-carlitos",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio web y catálogo de Automotora Carlitos (Cno. Cibils 5700, Montevideo)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "crear-admin": "node --env-file-if-exists=.env scripts/create-admin.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test \"test/**/*.test.js\"",
    "generar": "node scripts/generar.js",
    "local": "node scripts/generar.js --local && python3 -m http.server 8792 -d _site"
  },
  "dependencies": {
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "multer": "^2.5.0"
  }
}
