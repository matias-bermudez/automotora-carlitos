# Número de WhatsApp que recibe las consultas (código de país + número, sin + ni espacios).
# Pruebas: 091 969 322. Número oficial de la automotora: 096 665 018 → 59896665018
WHATSAPP_NUMBER=59891969322

# URL pública del sitio, se usa en los links que se mandan por WhatsApp y en las vistas previas.
# Si queda vacía se toma del dominio con el que se entra.
SITE_URL=

# Clave larga y aleatoria para firmar la sesión del admin.
# Generala con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Carpeta donde se guardan la base de datos y las fotos (en producción, un disco persistente).
DATA_DIR=./data

PORT=3000
