<%- include('partials/head') %>
<%- include('partials/header') %>
<% const shots = ['Frente', 'Lateral', 'Trasera', 'Interior', 'Tablero (km)', 'Motor']; %>

<section class="sell-hero">
  <div class="checker sell-hero-checker" aria-hidden="true"></div>
  <div class="sell-hero-dark" aria-hidden="true"></div>
  <div class="sell-hero-gold" aria-hidden="true"></div>
  <div class="wrap">
    <div class="stack" style="gap: 14px">
      <span class="eyebrow" style="color: #fff">Te compramos el auto</span>
      <h1 class="display" style="font-size: clamp(50px, 7vw, 88px); line-height: 0.9; color: #fff">Vendé tu auto</h1>
      <p>Completá los datos del auto y te abrimos WhatsApp con el mensaje listo. Las fotos nos las mandás por el mismo chat y te contestamos con una propuesta.</p>
    </div>
    <ol class="steps">
      <li><span class="gold num">1</span><span><strong>Completá tus datos y los del auto</strong><small>Marca, modelo, año, kilómetros</small></span></li>
      <li><span class="gold num">2</span><span><strong>Enviá el mensaje por WhatsApp</strong><small>Se abre el chat con todo ya escrito</small></span></li>
      <li><span class="gold num">3</span><span><strong>Mandanos las fotos por ese chat</strong><small>Frente, lateral, interior y tablero</small></span></li>
    </ol>
  </div>
</section>

<section class="wrap sell">
  <form id="vender" class="sell-form" data-wa-form="vender" data-wa-number="<%= waNumber %>" aria-label="Datos del auto a vender" novalidate>
    <fieldset class="panel">
      <legend>Tus datos</legend>
      <div class="form-grid">
        <label class="field">Nombre y apellido *
          <input class="input" type="text" name="nombre" required maxlength="60" placeholder="Tu nombre" autocomplete="name">
        </label>
        <label class="field">Celular *
          <input class="input" type="tel" name="celular" required maxlength="20" placeholder="09X XXX XXX" autocomplete="tel">
        </label>
        <label class="field">Barrio o ciudad
          <input class="input" type="text" name="zona" maxlength="60" placeholder="Ej: Paso de la Arena">
        </label>
      </div>
    </fieldset>

    <fieldset class="panel">
      <legend>Tu auto</legend>
      <div class="form-grid">
        <label class="field">Marca *
          <input class="input" type="text" name="marca" required maxlength="40" placeholder="Ej: Chevrolet">
        </label>
        <label class="field">Modelo y versión *
          <input class="input" type="text" name="modelo" required maxlength="60" placeholder="Ej: Onix 1.4 LT">
        </label>
        <label class="field">Año
          <select class="input" name="anio">
            <option value="">Elegí el año</option>
            <% for (const y of years) { %><option><%= y %></option><% } %>
          </select>
        </label>
        <label class="field">Kilómetros
          <input class="input" type="text" name="km" inputmode="numeric" maxlength="9" placeholder="Ej: 85.000">
        </label>
        <label class="field">Combustible
          <select class="input" name="combustible">
            <option>Nafta</option><option>Diésel</option><option>Híbrido</option><option>Eléctrico</option><option>GNC</option>
          </select>
        </label>
        <label class="field">Transmisión
          <select class="input" name="transmision">
            <option>Manual</option><option>Automática</option>
          </select>
        </label>
        <label class="field">Precio pretendido (U$S)
          <input class="input" type="text" name="precio" inputmode="numeric" maxlength="9" placeholder="Opcional">
        </label>
      </div>
      <fieldset style="border: 0; margin: 0; padding: 0">
        <legend class="field" style="padding: 0; margin-bottom: 8px">¿Buscás permutar por otro auto?</legend>
        <div class="chips">
          <% for (const opt of ['No', 'Sí', 'Tal vez']) { %>
            <label class="chip chip-square"><input type="radio" name="permuta" value="<%= opt %>"<%- opt === 'No' ? ' checked' : '' %>><span><%= opt %></span></label>
          <% } %>
        </div>
      </fieldset>
      <label class="field">Comentarios
        <textarea class="input" name="comentarios" rows="4" maxlength="800" placeholder="Estado general, services, choques, detalles, si tiene deudas o está a tu nombre…"></textarea>
      </label>
    </fieldset>

    <fieldset class="panel">
      <legend>Fotos</legend>
      <div class="photo-callout">
        <span class="photo-callout-icon"><%- icon('camera', 24) %></span>
        <div>
          <strong>Las fotos van por WhatsApp</strong>
          <span class="soft">Cuando se abra el chat con tu mensaje, mandalo y después adjuntá las fotos del auto en esa misma conversación. Con buenas fotos te podemos dar un precio más rápido.</span>
        </div>
      </div>
      <span class="field">Fotos que nos ayudan a darte un precio:</span>
      <div class="shots">
        <% for (const s of shots) { %><div class="shot"><%- icon('camera', 20) %><%= s %></div><% } %>
      </div>
    </fieldset>
  </form>

  <aside class="sell-aside">
    <div class="panel chat">
      <div class="chat-head">
        <span class="chat-avatar">C</span>
        <span><strong style="display: block">Automotora Carlitos</strong><span class="muted" style="font-size: 13px">Así llega tu mensaje</span></span>
      </div>
      <div class="chat-body">
        <div class="bubble" data-wa-preview>Completá el formulario y acá vas a ver el mensaje.</div>
      </div>
    </div>

    <button class="btn btn-wa btn-block btn-cta" type="submit" form="vender"><%- icon('wa', 24) %>Enviar por WhatsApp</button>
    <p class="form-error" data-wa-error hidden>Completá nombre, celular, marca y modelo para enviar.</p>
    <div class="photo-callout" data-wa-sent hidden>
      <span class="photo-callout-icon" style="background: var(--wa); color: var(--bg)"><%- icon('check', 24) %></span>
      <div>
        <strong>¡Listo! Ahora mandá las fotos</strong>
        <span class="soft">Abrí el chat con <%= phoneLabel %> y adjuntá las fotos del auto. Si WhatsApp no se abrió, <a href="#" data-wa-retry>tocá acá</a>.</span>
      </div>
    </div>
    <p class="form-hint">Se abre WhatsApp con el mensaje listo para mandar a <%= phoneLabel %>. No hace falta registrarse.</p>

    <div class="panel" style="padding: 18px 20px; display: flex; flex-direction: column; gap: 6px">
      <span class="panel-title" style="font-size: 19px">¿Preferís traerlo?</span>
      <span class="soft" style="font-size: 15px">Pasá por <%= business.address %> de lunes a viernes de 8:30 a 19 o sábados de 8:30 a 16 y lo vemos en el momento.</span>
    </div>
  </aside>
</section>

<%- include('partials/footer', { hideFloat: true }) %>
