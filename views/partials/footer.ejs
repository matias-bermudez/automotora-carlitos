</main>
<div class="checker checker-strip" aria-hidden="true"></div>
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-col" style="max-width: 320px; gap: 14px">
      <a class="logo" href="/" aria-label="<%= business.name %>, inicio">
        <span class="chrome logo-small" style="font-size: 12px">AUTOMOTORA</span>
        <span class="gold logo-big" style="font-size: 36px">CARLITOS</span>
        <span class="chrome logo-small" style="font-size: 12px">CIBILS</span>
      </a>
      <p class="muted" style="margin: 0">Compra · Venta · Permuta de autos usados en Paso de la Arena, Montevideo.</p>
    </div>
    <div class="footer-col">
      <h2>Sitio</h2>
      <nav aria-label="Pie de página">
        <a href="/">Inicio</a>
        <a href="/catalogo">Catálogo</a>
        <a href="/vende-tu-auto">Vendé tu auto</a>
        <a href="/#contacto">Contacto</a>
      </nav>
    </div>
    <div class="footer-col">
      <h2>Visitanos</h2>
      <span><%= business.addressLong %></span>
      <span><%= business.area %></span>
      <span><%= business.hoursShort %></span>
      <a href="<%= wa.waLink() %>" target="_blank" rel="noopener" style="font-weight: 700">WhatsApp <%= phoneLabel %></a>
      <a href="<%= business.instagramUrl %>" target="_blank" rel="noopener" style="font-weight: 700">Instagram</a>
    </div>
  </div>
  <div class="wrap footer-bottom">© <%= new Date().getFullYear() %> <%= business.name %> · <%= business.address %>, Montevideo, Uruguay</div>
</footer>
<% if (typeof hideFloat === 'undefined') { %>
<a class="wa-float" href="<%= typeof floatLink !== 'undefined' ? floatLink : wa.waLink() %>" target="_blank" rel="noopener" aria-label="Escribinos por WhatsApp"><%- icon('wa', 30) %></a>
<% } %>
<script src="/static/js/site.js" defer></script>
</body>
</html>
