<%
  const url = carUrl(car);
  const title = `${car.brand} ${car.model} ${car.year}`;
  const reserved = car.status === 'reservado';
%>
<article class="card">
  <a class="card-media" href="<%= url %>" tabindex="-1" aria-hidden="true">
    <% if (car.cover) { %>
      <img src="<%= photoUrl(car.cover) %>" alt="" loading="lazy">
    <% } else { %>
      <span class="placeholder"><%- include('car-placeholder') %></span>
    <% } %>
    <% if (reserved) { %>
      <span class="badge badge-gold">Reservado</span>
    <% } else if (car.badge) { %>
      <span class="badge"><%= car.badge %></span>
    <% } %>
    <span class="tag-corner tr"><%= car.body_type %></span>
    <% if (car.photo_count > 1) { %><span class="tag-corner br"><%- icon('camera', 14) %><%= car.photo_count %> fotos</span><% } %>
  </a>
  <div class="card-body">
    <div>
      <div class="card-brand"><%= car.brand %></div>
      <h3 class="card-model"><a href="<%= url %>"><%= car.model %></a></h3>
    </div>
    <div class="pills">
      <span><%= car.year %></span>
      <span><%= format.kmLabel(car.km) %></span>
      <span><%= car.fuel %></span>
      <span><%= car.transmission %></span>
    </div>
    <div class="card-foot">
      <div>
        <div class="price-label">Precio</div>
        <div class="price"><%= format.priceLabel(car.price) %></div>
      </div>
      <div class="card-actions">
        <a class="btn btn-ghost" href="<%= url %>">Ver ficha</a>
        <a class="btn btn-wa btn-icon" href="<%= wa.waLink(wa.carInterestMessage(car, absoluteUrl(url))) %>" target="_blank" rel="noopener" aria-label="Consultar por WhatsApp por el <%= title %>"><%- icon('wa', 22) %></a>
      </div>
    </div>
  </div>
</article>
