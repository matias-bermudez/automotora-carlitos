<%- include('partials/head') %>
<%- include('partials/header') %>
<%
  const chipGroup = (name, all, options, current) => ({ name, all, options, current });
  const groups = [
    ['Marca', chipGroup('marca', 'Todas', facets.brands, filters.brand)],
    ['Tipo', chipGroup('tipo', 'Todos', facets.types, filters.type)],
    ['Transmisión', chipGroup('caja', 'Todas', transmissions, filters.trans)],
  ];
  const maxValue = filters.maxPrice || priceCeiling;
%>

<section class="page-head">
  <div class="page-head-red" aria-hidden="true"></div>
  <div class="checker page-head-checker" aria-hidden="true"></div>
  <div class="wrap">
    <div class="breadcrumb"><a href="/">Inicio</a> / Catálogo</div>
    <h1 class="display" style="font-size: clamp(46px, 6vw, 76px)">Autos <span class="gold">disponibles</span></h1>
    <p class="lead" style="font-size: 18px; max-width: 560px">Filtrá por marca, tipo o precio. Cada auto tiene su ficha con fotos y un botón para consultar directo por WhatsApp.</p>
  </div>
</section>

<div class="wrap catalog">
  <aside class="panel filters" aria-label="Filtros">
    <details open data-filters<%- hasFilters ? ' data-active' : '' %>>
      <summary>Filtros <%- icon('search', 20) %></summary>
      <form id="filtros" class="filters-body" action="/catalogo" method="get" data-autosubmit>
        <div class="filters-head">
          <span>Filtros</span>
          <% if (hasFilters) { %><a href="/catalogo">Limpiar</a><% } %>
        </div>

        <label class="field field-label-caps">Buscar
          <input class="input" type="search" name="q" value="<%= filters.q %>" placeholder="Ej: Onix, Polo…" maxlength="60">
        </label>

        <% for (const [label, g] of groups) { if (!g.options.length) continue; %>
          <fieldset style="border: 0; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px">
            <legend class="field-label-caps" style="padding: 0; margin-bottom: 10px"><%= label %></legend>
            <div class="chips">
              <label class="chip"><input type="radio" name="<%= g.name %>" value=""<%- g.current ? '' : ' checked' %>><span><%= g.all %></span></label>
              <% for (const opt of g.options) { %>
                <label class="chip"><input type="radio" name="<%= g.name %>" value="<%= opt %>"<%- g.current === opt ? ' checked' : '' %>><span><%= opt %></span></label>
              <% } %>
            </div>
          </fieldset>
        <% } %>

        <label class="field field-label-caps">
          <span style="display: flex; justify-content: space-between"><span>Precio hasta</span><span style="color: var(--text); letter-spacing: 0" data-price-output><%= filters.maxPrice ? format.priceLabel(filters.maxPrice) : 'Sin límite' %></span></span>
          <input type="range" name="hasta" min="5000" max="<%= priceCeiling %>" step="500" value="<%= maxValue %>" data-price-range data-ceiling="<%= priceCeiling %>">
          <span style="display: flex; justify-content: space-between; font-weight: 500; letter-spacing: 0; text-transform: none"><span>U$S 5.000</span><span>U$S <%= format.thousands(priceCeiling) %></span></span>
        </label>

        <noscript><button class="btn btn-red btn-block" type="submit">Aplicar filtros</button></noscript>
        <% if (hasFilters) { %><a class="btn btn-ghost btn-block" href="/catalogo">Limpiar filtros</a><% } %>
        <a class="btn btn-wa btn-block" href="<%= wa.waLink('Hola! Busco un auto que no vi en la web.') %>" target="_blank" rel="noopener" style="font-size: 15px">¿No está el que buscás? Escribinos</a>
      </form>
    </details>
  </aside>

  <div class="results">
    <div class="results-head">
      <span class="soft" style="font-size: 17px"><strong style="color: var(--text); font-size: 20px"><%= total %></strong> <%= total === 1 ? 'auto encontrado' : 'autos encontrados' %></span>
      <label>Ordenar por
        <select class="input" name="orden" form="filtros" data-autosubmit-field>
          <% for (const [value, label] of sortOptions) { %>
            <option value="<%= value %>"<%- filters.sort === value ? ' selected' : '' %>><%= label %></option>
          <% } %>
        </select>
      </label>
    </div>

    <% if (!cars.length) { %>
      <div class="empty">
        <strong><%= hasFilters ? 'Sin resultados con esos filtros' : 'Todavía no hay autos publicados' %></strong>
        <span class="muted">Probá con otra marca o subí el precio. También podés escribirnos y te avisamos cuando entre.</span>
        <% if (hasFilters) { %><a class="btn btn-red" href="/catalogo">Ver todos los autos</a><% } %>
      </div>
    <% } else { %>
      <div class="grid-cards" style="grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr)); gap: 20px">
        <% for (const car of cars) { %><%- include('partials/car-card', { car }) %><% } %>
      </div>
    <% } %>

    <% if (pages > 1) { %>
      <nav class="pagination" aria-label="Paginación">
        <% if (page > 1) { %><a href="<%= pageUrl(page - 1) %>" aria-label="Página anterior"><%- icon('arrowLeft', 18, { width: 2.4 }) %></a><% } %>
        <% for (let n = 1; n <= pages; n++) { %>
          <% if (n === page) { %><span aria-current="page"><%= n %></span><% } else { %><a href="<%= pageUrl(n) %>"><%= n %></a><% } %>
        <% } %>
        <% if (page < pages) { %><a href="<%= pageUrl(page + 1) %>" aria-label="Página siguiente"><%- icon('arrowRight', 18, { width: 2.4 }) %></a><% } %>
      </nav>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>
