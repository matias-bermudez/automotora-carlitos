<%- include('../partials/head', { extraCss: '/static/css/admin.css' }) %>
<%- include('_header') %>
<%
  const isNew = !car.id;
  const action = isNew ? '/admin/autos' : `/admin/autos/${car.id}`;
  const label = (s) => s[0].toUpperCase() + s.slice(1);
  const statusHelp = {
    borrador: 'No se ve en la web. Sirve para ir cargándolo.',
    disponible: 'Aparece en el catálogo.',
    reservado: 'Sigue en el catálogo con la etiqueta "Reservado".',
    vendido: 'Sale del catálogo pero queda en el historial. El link sigue andando y muestra "Vendido".',
  };
%>

<main class="wrap admin-main">
  <div class="admin-title">
    <div>
      <a class="link-arrow" href="/admin"><%- icon('arrowLeft', 18) %>Volver a la lista</a>
      <h1 class="display" style="font-size: 44px"><%= isNew ? 'Cargar auto' : `${car.brand} ${car.model}` %></h1>
    </div>
    <% if (!isNew && car.status !== 'borrador') { %>
      <a class="btn btn-ghost" href="<%= carUrl(car) %>" target="_blank" rel="noopener"><%- icon('eye', 20) %>Ver en el sitio</a>
    <% } else if (!isNew) { %>
      <a class="btn btn-ghost" href="<%= carUrl(car) %>" target="_blank" rel="noopener"><%- icon('eye', 20) %>Vista previa</a>
    <% } %>
  </div>

  <% if (errors.length) { %>
    <div class="alert alert-error">
      <strong>Revisá estos datos:</strong>
      <ul><% for (const e of errors) { %><li><%= e %></li><% } %></ul>
    </div>
  <% } %>

  <form class="car-form" method="post" action="<%= action %>" enctype="multipart/form-data" data-car-form>
    <fieldset class="panel">
      <legend>Datos principales</legend>
      <div class="form-grid">
        <label class="field">Marca *
          <input class="input" name="brand" value="<%= car.brand %>" required maxlength="40" placeholder="Chevrolet" list="marcas">
        </label>
        <label class="field">Modelo y versión *
          <input class="input" name="model" value="<%= car.model %>" required maxlength="80" placeholder="Onix 1.0 Turbo LT">
        </label>
        <label class="field">Año *
          <input class="input" name="year" value="<%= car.year %>" required inputmode="numeric" maxlength="4">
        </label>
        <label class="field">Precio (U$S)
          <input class="input" name="price" value="<%= car.price ? format.thousands(car.price) : '' %>" inputmode="numeric" placeholder="Vacío = &quot;Consultar&quot;">
        </label>
        <label class="field">Kilómetros
          <input class="input" name="km" value="<%= car.km === '' ? '' : format.thousands(car.km) %>" inputmode="numeric" placeholder="48.000">
        </label>
        <label class="field">Tipo
          <select class="input" name="body_type"><% for (const t of bodyTypes) { %><option<%- car.body_type === t ? ' selected' : '' %>><%= t %></option><% } %></select>
        </label>
        <label class="field">Combustible
          <select class="input" name="fuel"><% for (const f of fuels) { %><option<%- car.fuel === f ? ' selected' : '' %>><%= f %></option><% } %></select>
        </label>
        <label class="field">Transmisión
          <select class="input" name="transmission"><% for (const t of transmissions) { %><option<%- car.transmission === t ? ' selected' : '' %>><%= t %></option><% } %></select>
        </label>
        <label class="field">Motor
          <input class="input" name="engine" value="<%= car.engine %>" maxlength="40" placeholder="1.0 Turbo">
        </label>
        <label class="field">Color
          <input class="input" name="color" value="<%= car.color %>" maxlength="40" placeholder="Gris plata">
        </label>
        <label class="field">Puertas
          <input class="input" name="doors" value="<%= car.doors || '' %>" inputmode="numeric" maxlength="1" placeholder="5">
        </label>
        <label class="field">Etiqueta (opcional)
          <input class="input" name="badge" value="<%= car.badge %>" maxlength="30" placeholder="Recién ingresado" list="etiquetas">
        </label>
      </div>
      <datalist id="marcas"><% for (const b of ['Chevrolet', 'Volkswagen', 'Hyundai', 'Renault', 'Toyota', 'Fiat', 'Peugeot', 'Citroën', 'Ford', 'Nissan', 'Kia', 'Suzuki', 'Honda', 'BYD', 'Chery', 'Geely', 'JAC', 'Mercedes-Benz', 'BMW', 'Audi']) { %><option value="<%= b %>"><% } %></datalist>
      <datalist id="etiquetas"><% for (const b of ['Recién ingresado', 'Único dueño', 'Oportunidad', 'Impecable', 'Financiación']) { %><option value="<%= b %>"><% } %></datalist>
    </fieldset>

    <fieldset class="panel">
      <legend>Fotos</legend>
      <% if (car.photos.length) { %>
        <p class="muted" style="margin: 0">Elegí cuál va de portada (la primera que se ve) y marcá las que quieras borrar.</p>
        <div class="photo-grid">
          <% car.photos.forEach((p, i) => { %>
            <div class="photo-item">
              <img src="<%= photoUrl(p.filename) %>" alt="Foto <%= i + 1 %>" loading="lazy">
              <label class="photo-opt"><input type="radio" name="cover" value="<%= p.id %>"<%- i === 0 ? ' checked' : '' %>> Portada</label>
              <label class="photo-opt photo-del"><input type="checkbox" name="delete_photo" value="<%= p.id %>"> Borrar</label>
            </div>
          <% }) %>
        </div>
      <% } %>
      <label class="dropzone">
        <%- icon('camera', 32) %>
        <strong>Tocá para elegir o sacar fotos</strong>
        <span class="muted">Podés elegir varias a la vez · hasta <%= maxPhotos %> por auto · se achican solas antes de subir</span>
        <input type="file" name="photos" accept="image/jpeg,image/png,image/webp,image/heic,image/heif" multiple data-photo-input>
      </label>
      <div class="photo-grid" data-photo-preview></div>
    </fieldset>

    <fieldset class="panel">
      <legend>Descripción</legend>
      <label class="field">Descripción
        <textarea class="input" name="description" rows="5" maxlength="4000" placeholder="Estado, services, papeles, lo que lo hace un buen auto… Cada renglón es un párrafo."><%= car.description %></textarea>
      </label>
      <label class="field">Equipamiento (uno por renglón)
        <textarea class="input" name="equipment" rows="6" maxlength="2000" placeholder="Aire acondicionado&#10;Dirección asistida&#10;Cámara de retroceso"><%= car.equipment %></textarea>
      </label>
    </fieldset>

    <fieldset class="panel">
      <legend>Publicación</legend>
      <div class="status-options">
        <% for (const s of statuses) { %>
          <label class="status-option">
            <input type="radio" name="status" value="<%= s %>"<%- car.status === s ? ' checked' : '' %>>
            <span><strong><%= label(s) %></strong><small><%= statusHelp[s] %></small></span>
          </label>
        <% } %>
      </div>
      <label class="check">
        <input type="checkbox" name="featured" value="1"<%- car.featured ? ' checked' : '' %>>
        <span><strong>Destacado de la semana</strong> · sale grande en la portada (solo uno a la vez)</span>
      </label>
    </fieldset>

    <div class="form-actions">
      <p class="alert alert-error" data-upload-error hidden></p>
      <button class="btn btn-red btn-lg" type="submit" data-submit><%= isNew ? 'Guardar auto' : 'Guardar cambios' %></button>
      <span class="muted" data-upload-status></span>
    </div>
  </form>

  <% if (!isNew) { %>
    <form class="danger-zone panel" method="post" action="/admin/autos/<%= car.id %>/borrar" data-confirm="¿Seguro que querés borrar este auto y todas sus fotos? Esto no se puede deshacer. Si ya se vendió, mejor marcalo como Vendido para que quede en el historial.">
      <div>
        <strong>Borrar publicación</strong>
        <p class="muted" style="margin: 0">Si el auto se vendió, conviene marcarlo como <em>Vendido</em> en vez de borrarlo, así queda en el historial.</p>
      </div>
      <button class="btn btn-ghost danger" type="submit"><%- icon('trash', 18) %>Borrar</button>
    </form>
  <% } %>
</main>
<script src="/static/js/admin.js" defer></script>
</body>
</html>
