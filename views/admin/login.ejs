<%- include('../partials/head', { extraCss: '/static/css/admin.css' }) %>
<%- include('_header') %>

<main class="wrap admin-main" style="max-width: 460px">
  <form class="panel admin-card" method="post" action="/admin/login">
    <h1 class="display" style="font-size: 40px">Entrar</h1>
    <p class="muted" style="margin: 0">Panel para cargar y editar los autos del catálogo.</p>
    <% if (error) { %><p class="alert alert-error"><%= error %></p><% } %>
    <label class="field">Usuario
      <input class="input" name="username" value="<%= username %>" autocomplete="username" autocapitalize="none" required autofocus>
    </label>
    <label class="field">Contraseña
      <input class="input" type="password" name="password" autocomplete="current-password" required>
    </label>
    <button class="btn btn-red btn-block" type="submit">Entrar</button>
  </form>
</main>
</body>
</html>
